# Copy to .env.padelapp — never commit secrets.
# Isolated from VoiceAction / Survival / Dental. Do not reuse those env files.

NODE_ENV=development

# Ports chosen so they never collide with other apps on this machine.
PADELAPP_API_PORT=3040
PADELAPP_API_HOST=0.0.0.0
# Optional override for a physical phone. Expo auto-detects LAN IP if unset.
# EXPO_PUBLIC_PADELAPP_API_URL=http://192.168.1.10:3040
EXPO_PORT=8084
METRO_PORT=8084

# Isolated file Postgres (PGlite) — no Docker required, data stays in ./data.
PADELAPP_DATABASE_URL=pglite:./data/pglite
# When Docker Desktop is running: npm run db:up and use:
# PADELAPP_DATABASE_URL=postgres://padelapp:padelapp@127.0.0.1:5433/padelapp

# Internal seed only — not a customer password.
PADELAPP_SEED_PASSWORD=padel-dev
